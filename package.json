{
  "name": "questday",
  "version": "2.1.0",
  "description": "QuestDay — a quest-based daily productivity guide",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "QuestDay",
  "scripts": {
    "dev": "node scripts/with-app.mjs electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pw": "node scripts/pw-run.mjs",
    "pw:arcade": "node scripts/with-app.mjs node scripts/pw-arcade.mjs",
    "pw:eisenhower": "node scripts/pw-eisenhower.mjs",
    "pw:timeboxing": "node scripts/pw-timeboxing.mjs",
    "pw:realm": "node scripts/pw-realm.mjs",
    "pw:rewards": "node scripts/pw-rewards.mjs",
    "pw:prayer": "node scripts/pw-prayer.mjs",
    "pw:prayer-frames": "node scripts/pw-prayer-frames.mjs",
    "pw:winddown": "node scripts/pw-winddown.mjs",
    "pw:bundles": "node scripts/pw-bundles.mjs",
    "pw:observances": "node scripts/pw-observances.mjs",
    "pw:library": "node scripts/pw-library.mjs",
    "pw:rollover": "node scripts/pw-rollover.mjs",
    "pw:deck": "node scripts/pw-deck.mjs",
    "pw:sharecard": "node scripts/pw-sharecard.mjs",
    "pw:sharestudio": "node scripts/pw-sharestudio.mjs",
    "pw:theme": "node scripts/pw-theme.mjs",
    "dist": "node scripts/with-app.mjs \"electron-vite build && electron-builder --win -c.directories.output=C:/Users/ihusa/questday-release\"",
    "dist:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "build": {
    "appId": "com.questday.app",
    "productName": "QuestDay",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      "resources/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuestDay"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^11.11.17",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
